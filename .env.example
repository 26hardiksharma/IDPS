# XAI-IDPS Local Configuration
# Copy this file to .env and fill in values for your environment.
# Never commit the real .env file with secrets.

# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Database (SQLite, local only)
DATABASE_URL=sqlite+aiosqlite:///./data/xai_idps.db

# PCAP and data directories
PCAP_ROOT=./data/pcaps
DATA_DIR=./data
MAX_PCAP_MB=100

# Snort 3
# Set SNORT_BIN to the full path of the snort binary if not in PATH
SNORT_BIN=snort
SNORT_CONFIG=../config/snort/snort.lua
SNORT_RULES_DIR=../rules/snort
SNORT_OUTPUT_DIR=./data/outputs/snort
SNORT_TIMEOUT_SECONDS=300

# Ollama (local model — no external API)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Choose a model available in your local Ollama installation.
# Small quantized models are recommended for laptop hardware.
# Example: llama3.2, phi3.5, mistral
OLLAMA_MODEL=llama3.2
EXPLANATION_TIMEOUT_SECONDS=60
PROMPT_TEMPLATE_VERSION=1.0

# Anomaly detection thresholds
# Calibrate these against your test corpus before reporting results.
ANOMALY_THRESHOLD_DISTINCT_PORTS=20
ANOMALY_THRESHOLD_PKT_RATE=100
ANOMALY_THRESHOLD_DNS_QUERIES=30
ANOMALY_THRESHOLD_DNS_ENTROPY=3.5
ANOMALY_FEATURE_WINDOW_SECONDS=30

# Correlation
CORRELATION_TIME_WINDOW_SECONDS=300
SCORING_POLICY_VERSION=1.0

# Evaluation corpus
EVAL_CORPUS_DIR=./data/corpus
